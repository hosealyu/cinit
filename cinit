#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REGISTRY="$SCRIPT_DIR/build-systems.conf"
COMPILER_REGISTRY="$SCRIPT_DIR/compilers.conf"
TEMPLATE_ROOT="$SCRIPT_DIR/templates"
requested_build_tool=""
requested_compiler=""
requested_target=""
build_tool_provided=false
compiler_provided=false
target_provided=false
initialize_git=true

usage() {
  printf 'Usage: %s [--build-tool ID | --compiler ID] [--target PATH] [--no-git]\n' "${0##*/}"
  printf '  --build-tool ID  Select an installed build system (make, cmake, bazel, meson)\n'
  printf '  --compiler ID    Compile directly with an installed compiler (cc, gcc, clang)\n'
  printf '  --target PATH    Create the project at PATH; use . for the current directory\n'
  printf '  --no-git         Skip initializing a Git repository\n'
  printf '  -h, --help       Show this help\n'
}

while (($# > 0)); do
  case "$1" in
    --build-tool)
      if [[ "$build_tool_provided" == true || $# -lt 2 || -z "$2" ]]; then
        printf 'Error: --build-tool must be provided once with a non-empty ID.\n' >&2
        usage >&2
        exit 2
      fi
      requested_build_tool="$2"
      build_tool_provided=true
      shift 2
      ;;
    --compiler)
      if [[ "$compiler_provided" == true || $# -lt 2 || -z "$2" ]]; then
        printf 'Error: --compiler must be provided once with a non-empty ID.\n' >&2
        usage >&2
        exit 2
      fi
      requested_compiler="$2"
      compiler_provided=true
      shift 2
      ;;
    --target)
      if [[ "$target_provided" == true || $# -lt 2 || -z "$2" ]]; then
        printf 'Error: --target must be provided once with a non-empty path.\n' >&2
        usage >&2
        exit 2
      fi
      requested_target="$2"
      target_provided=true
      shift 2
      ;;
    --no-git)
      initialize_git=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Error: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$build_tool_provided" == true && "$compiler_provided" == true ]]; then
  printf 'Error: choose either --build-tool or --compiler, not both.\n' >&2
  usage >&2
  exit 2
fi

if [[ ! -f "$REGISTRY" ]]; then
  printf 'Error: build-system registry not found: %s\n' "$REGISTRY" >&2
  exit 1
fi

declare -a choice_ids=()
declare -a choice_labels=()
declare -a choice_tools=()
declare -a choice_kinds=()

while IFS=$'\t' read -r id label candidates; do
  [[ -z "$id" || "$id" == \#* ]] && continue

  selected_tool=""
  IFS='|' read -r -a candidate_list <<< "$candidates"
  for candidate in "${candidate_list[@]}"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      selected_tool="$candidate"
      break
    fi
  done

  if [[ -n "$selected_tool" ]]; then
    choice_ids+=("$id")
    choice_labels+=("$label")
    choice_tools+=("$selected_tool")
    choice_kinds+=("build")
  fi
done < "$REGISTRY"

if [[ -f "$COMPILER_REGISTRY" ]]; then
  while IFS=$'\t' read -r id label candidates; do
    [[ -z "$id" || "$id" == \#* ]] && continue

    selected_compiler=""
    IFS='|' read -r -a candidate_list <<< "$candidates"
    for candidate in "${candidate_list[@]}"; do
      if command -v "$candidate" >/dev/null 2>&1; then
        selected_compiler="$candidate"
        break
      fi
    done
    if [[ -n "$selected_compiler" ]]; then
      choice_ids+=("$id")
      choice_labels+=("$label")
      choice_tools+=("$selected_compiler")
      choice_kinds+=("compiler")
    fi
  done < "$COMPILER_REGISTRY"
fi

if [[ "$build_tool_provided" == true || "$compiler_provided" == true ]]; then
  requested_kind="build"
  requested_id="$requested_build_tool"
  if [[ "$compiler_provided" == true ]]; then
    requested_kind="compiler"
    requested_id="$requested_compiler"
  fi

  selection=-1
  for i in "${!choice_ids[@]}"; do
    if [[ "${choice_kinds[$i]}" == "$requested_kind" && "${choice_ids[$i]}" == "$requested_id" ]]; then
      selection=$i
      break
    fi
  done
  if ((selection < 0)); then
    if [[ "$requested_kind" == "build" ]]; then
      printf 'Error: build system "%s" is not installed or supported. Choose one of:' "$requested_id" >&2
    else
      printf 'Error: compiler "%s" is not installed or supported. Choose one of:' "$requested_id" >&2
    fi
    for i in "${!choice_ids[@]}"; do
      if [[ "${choice_kinds[$i]}" == "$requested_kind" ]]; then
        printf ' %s' "${choice_ids[$i]}" >&2
      fi
    done
    printf '\n' >&2
    exit 1
  fi
else
  if ((${#choice_ids[@]} == 0)); then
    printf 'No supported build system or C compiler was found.\n' >&2
    printf 'Install a C compiler, or install one of Make, CMake, Bazel, or Meson and run this script again.\n' >&2
    exit 1
  fi

  printf 'Detected build systems and compilers:\n'
  for i in "${!choice_ids[@]}"; do
    if [[ "${choice_kinds[$i]}" == "build" ]]; then
      choice_type="Build tool"
    else
      choice_type="Compiler"
    fi
    printf '  %d) %s: %s (%s)\n' "$((i + 1))" "$choice_type" "${choice_labels[$i]}" "${choice_tools[$i]}"
  done

  while true; do
    printf 'Choose a build tool or compiler [1-%d]: ' "${#choice_ids[@]}"
    if ! IFS= read -r choice; then
      printf '\nError: no selection received.\n' >&2
      exit 1
    fi
    if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#choice_ids[@]})); then
      selection=$((choice - 1))
      break
    fi
    printf 'Please enter a number from 1 to %d.\n' "${#choice_ids[@]}" >&2
  done
fi

if [[ "${choice_kinds[$selection]}" == "compiler" ]]; then
  template_id="manual"
  compiler_name="${choice_tools[$selection]}"
else
  template_id="${choice_ids[$selection]}"
  compiler_name=""
fi

if [[ "$target_provided" == true ]]; then
  project_dir="$requested_target"
  if [[ "$project_dir" == "." ]]; then
    destination="."
  elif [[ "$project_dir" == /* ]]; then
    destination="$project_dir"
  else
    destination="$PWD/$project_dir"
  fi
else
  while true; do
    printf 'Project directory path (use . for the current directory): '
    if ! IFS= read -r project_dir; then
      printf '\nError: no project directory path received.\n' >&2
      exit 1
    fi

    if [[ -z "$project_dir" ]]; then
      printf 'Enter a non-empty directory path, or . for the current directory.\n' >&2
      continue
    fi
    break
  done

  if [[ "$project_dir" == "." ]]; then
    destination="."
  elif [[ "$project_dir" == /* ]]; then
    destination="$project_dir"
  else
    destination="$PWD/$project_dir"
  fi
fi

if [[ -L "$destination" ]]; then
  printf 'Error: destination must not be a symbolic link: %s\n' "$destination" >&2
  exit 1
fi
if [[ -e "$destination" ]]; then
  if [[ ! -d "$destination" ]]; then
    printf 'Error: destination exists and is not a directory: %s\n' "$destination" >&2
    exit 1
  fi
  shopt -s dotglob nullglob
  existing_entries=("$destination"/*)
  shopt -u dotglob nullglob
  if ((${#existing_entries[@]} > 0)); then
    printf 'Error: destination directory is not empty; refusing to overwrite files: %s\n' "$destination" >&2
    exit 1
  fi
fi

template_dir="$TEMPLATE_ROOT/$template_id"
if [[ ! -d "$template_dir" ||
  ! -f "$TEMPLATE_ROOT/common/src/main.c" ||
  ! -f "$TEMPLATE_ROOT/common/src/hello.c" ||
  ! -f "$TEMPLATE_ROOT/common/include/hello.h" ||
  ! -f "$TEMPLATE_ROOT/common/tests/test_hello.c" ||
  ! -f "$TEMPLATE_ROOT/common/.gitignore" ]]; then
  printf 'Error: scaffold templates are missing for %s.\n' "${choice_labels[$selection]}" >&2
  exit 1
fi

if [[ ! -e "$destination" ]]; then
  if ! mkdir -p -- "$destination"; then
    printf 'Error: could not create destination directory: %s\n' "$destination" >&2
    exit 1
  fi
fi

if [[ "$destination" == "." ]]; then
  executable_name="hello-world"
else
  project_name="$(basename -- "$destination")"
  executable_name="$(printf '%s' "$project_name" | LC_ALL=C tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  if [[ -z "$executable_name" ]]; then
    executable_name="hello-world"
  elif [[ "$executable_name" =~ ^[0-9] ]]; then
    executable_name="project-${executable_name:0:56}"
  else
    executable_name="${executable_name:0:64}"
  fi
fi

cp -R -- "$TEMPLATE_ROOT/common/src" "$TEMPLATE_ROOT/common/include" "$TEMPLATE_ROOT/common/tests" "$destination/"
sed "s/@EXECUTABLE_NAME@/$executable_name/g" "$TEMPLATE_ROOT/common/.gitignore" > "$destination/.gitignore"
for template in "$template_dir"/*; do
  [[ -f "$template" ]] || continue
  sed -e "s/@EXECUTABLE_NAME@/$executable_name/g" -e "s/@COMPILER_NAME@/$compiler_name/g" "$template" > "$destination/$(basename -- "$template")"
done

if [[ "$initialize_git" == true ]]; then
  if ! command -v git >/dev/null 2>&1; then
    printf 'Error: Git is not installed; skipping Git repository initialization.\n' >&2
  elif ! git -C "$destination" init -q; then
    printf 'Error: project files were created, but Git repository initialization failed in %s.\n' "$destination" >&2
    exit 1
  else
    printf 'Initialized a Git repository.\n'
  fi
fi

printf 'Created a %s C project in %s (executable: %s)\n' "${choice_labels[$selection]}" "$destination" "$executable_name"
